# These are environment variable names; the app does not auto-load this file.
# Never commit or share actual credentials.
WEALTH_DB=data/wealth.db
WEALTH_SECURE_COOKIES=false
WEALTH_REGISTRATION=true
# Set these behind your HTTPS reverse proxy for eventual public deployment:
# WEALTH_PUBLIC_ORIGIN=https://your-chosen-domain.example
# WEALTH_SECURE_COOKIES=true

# Optional cloud interpretation. Each query still requires the user's opt-in.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Private, local installation only. Leave false on any shared/public server.
STELLARIUM_ENABLED=false
STELLARIUM_URL=http://127.0.0.1:8090
# STELLARIUM_PASSWORD=

# Optional existing, legally obtained Swiss Ephemeris data directory.
# WCC_EPHE_PATH=/absolute/path/to/ephemeris
